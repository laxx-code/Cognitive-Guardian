<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only manifest override.

  INTERNET is required in debug builds so the app can connect to the Metro
  bundler on localhost (JS hot reload / dev menu). It is intentionally NOT
  present in src/main/AndroidManifest.xml, so release builds ship with zero
  network capability — this is what makes the "zero network calls, ever"
  privacy claim actually true for anything a user installs.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <application
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:replace="android:usesCleartextTraffic,android:networkSecurityConfig" />
</manifest>
